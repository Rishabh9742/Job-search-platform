# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://jobpilot:jobpilot@localhost:5433/jobpilot?schema=public"
REDIS_URL="redis://localhost:6380"
APP_URL="http://localhost:3000"
# 32-byte key, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""
# Directory for encrypted uploaded resumes and generated documents (outside /public).
STORAGE_DIR="./storage"

# ── AI provider ──────────────────────────────────────────────────────
# "anthropic" (recommended) or "none" (deterministic, rule-based extraction and tailoring only).
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ── Job discovery providers (optional; keyless providers work out of the box) ──
# Adzuna: https://developer.adzuna.com/  (covers gb, us, ca, in, au, nz, sg, de, fr, nl, ...)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# USAJOBS: https://developer.usajobs.gov/apirequest/  (US federal vacancies)
USAJOBS_API_KEY=""
USAJOBS_USER_AGENT_EMAIL=""
# Comma-separated public board tokens to crawl (added to the defaults below).
GREENHOUSE_BOARDS=""
LEVER_SITES=""
ASHBY_BOARDS=""

# ── Development ──────────────────────────────────────────────────────
# When "true", a clearly-labelled MOCK job source is enabled. Mock jobs are never submitted live.
MOCK_MODE="false"
# Number of concurrent submission workers
SUBMISSION_CONCURRENCY="2"
